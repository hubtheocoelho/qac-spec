{
  "name": "@qac/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that standardizes git commits with QAC (Qualified Agent Commits) trailers, built on the MCP Orchestrator SDK",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qac-mcp-server": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
