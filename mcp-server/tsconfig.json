{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mcp-orchestrator/core": ["../third_party/mcp-orchestrator-sdk/packages/core/src/index.ts"],
      "@mcp-orchestrator/mcp": ["../third_party/mcp-orchestrator-sdk/packages/mcp/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
