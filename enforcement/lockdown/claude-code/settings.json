{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "mcp__qac__qac_commit",
      "mcp__qac__qac_validate",
      "mcp__qac__qac_format"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "Monitor",
      "NotebookEdit",
      "mcp__qac__qac_install_hook",
      "mcp__qac__resume_workflow",
      "Edit(/.git/**)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)"
    ]
  },
  "enabledMcpjsonServers": ["qac"],
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/qac-guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
